QLineEdit {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 9px 12px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;
    min-height: 18px;
}
QLineEdit:focus {
    border: 1px solid #89b4fa;
    background-color: #363752;
}
QLineEdit:hover:!read-only {
    border: 1px solid #6c7086;
}
/* 에러 메시지 라인 (읽기 전용) */
QLineEdit#lineEdit {
    background-color: transparent;
    border: none;
    color: #f38ba8;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 2px;
    min-height: 14px;
}
QLineEdit#lineEdit:focus {
    background-color: transparent;
    border: none;
}
QSpinBox {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 9px 12px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;
    min-height: 18px;
}
QSpinBox:focus {
    border: 1px solid #89b4fa;
    background-color: #363752;
}
QSpinBox:hover {
    border: 1px solid #6c7086;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #45475a;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #585b70;
}
QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #cdd6f4;
    width: 0; height: 0;
}
QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cdd6f4;
    width: 0; height: 0;
}
QDialogButtonBox QPushButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 8px;
    padding: 9px 22px;
    font-weight: 600;
    min-width: 80px;
    min-height: 20px;
}
QDialogButtonBox QPushButton:hover {
    background-color: #a5c4fb;
}
QDialogButtonBox QPushButton:pressed {
    background-color: #74a0e8;
}
/* Cancel 버튼은 세컨더리 스타일 */
QDialogButtonBox QPushButton[text="Cancel"],
QDialogButtonBox QPushButton[text="취소"] {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
}
QDialogButtonBox QPushButton[text="Cancel"]:hover,
QDialogButtonBox QPushButton[text="취소"]:hover {
    background-color: #45475a;
    border: 1px solid #89b4fa;
}
