  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #1e1e2e;
}
QWidget {
    color: #cdd6f4;
    font-family: &quot;Segoe UI&quot;, &quot;Malgun Gothic&quot;, sans-serif;
    font-size: 13px;
}
QWidget#filterCard, QWidget#resultCard {
    background-color: #242436;
    border: 1px solid #313244;
    border-radius: 14px;
}
QLabel {
    color: #a6adc8;
    font-weight: 500;
    background: transparent;
}
QLabel#label {
    color: #cdd6f4;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}
QLabel#label_3, QLabel#label_6, QLabel#label_10, QLabel#label_2 {
    color: #cba6f7;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}
QLineEdit, QSpinBox, QDateEdit, QComboBox {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 8px 12px;
    color: #cdd6f4;
    selection-background-color: #cba6f7;
    min-height: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #cba6f7;
    background-color: #363752;
}
QLineEdit:hover, QSpinBox:hover, QDateEdit:hover, QComboBox:hover {
    border: 1px solid #6c7086;
}
/* SpinBox arrows */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #45475a;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #585b70;
}
QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #cdd6f4;
    width: 0; height: 0;
}
QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cdd6f4;
    width: 0; height: 0;
}
/* DateEdit drop-down */
QDateEdit::drop-down {
    background-color: #45475a;
    border: none;
    width: 22px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QDateEdit::drop-down:hover {
    background-color: #585b70;
}
QDateEdit::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cdd6f4;
    width: 0; height: 0;
}
/* ComboBox */
QComboBox::drop-down {
    background-color: #45475a;
    border: none;
    width: 22px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QComboBox::drop-down:hover {
    background-color: #585b70;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cdd6f4;
    width: 0; height: 0;
}
QComboBox QAbstractItemView {
    background-color: #242436;
    color: #cdd6f4;
    border: 1px solid #45475a;
    selection-background-color: #cba6f7;
    selection-color: #1e1e2e;
    outline: none;
}
/* Calendar popup */
QCalendarWidget QWidget {
    background-color: #242436;
    color: #cdd6f4;
}
QCalendarWidget QToolButton {
    background-color: #313244;
    color: #cdd6f4;
    border-radius: 4px;
    padding: 4px;
}
QCalendarWidget QToolButton:hover {
    background-color: #45475a;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #cba6f7;
    selection-color: #1e1e2e;
}
/* CheckBox */
QCheckBox {
    color: #cdd6f4;
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6c7086;
    border-radius: 4px;
    background-color: #313244;
}
QCheckBox::indicator:checked {
    background-color: #cba6f7;
    border: 1px solid #cba6f7;
}
QCheckBox::indicator:hover {
    border: 1px solid #cba6f7;
}
/* Buttons */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #45475a;
    border: 1px solid #cba6f7;
}
QPushButton:pressed {
    background-color: #585b70;
}
QPushButton#pushButton_3 {
    background-color: #cba6f7;
    color: #1e1e2e;
    border: none;
}
QPushButton#pushButton_3:hover {
    background-color: #d9bef8;
}
QPushButton#pushButton_3:pressed {
    background-color: #b093e8;
}
QPushButton#pushButton {
    background-color: #cba6f7;
    color: #1e1e2e;
    border: none;
}
QPushButton#pushButton:hover {
    background-color: #d9bef8;
}
QPushButton#pushButton:pressed {
    background-color: #b093e8;
}
/* Table */
QTableWidget {
    background-color: #1e1e2e;
    alternate-background-color: #242436;
    color: #cdd6f4;
    gridline-color: #313244;
    border: 1px solid #313244;
    border-radius: 8px;
    selection-background-color: #cba6f7;
    selection-color: #1e1e2e;
    outline: none;
}
QTableWidget::item {
    padding: 6px;
    border: none;
}
QTableWidget::item:selected {
    background-color: #cba6f7;
    color: #1e1e2e;
}
QHeaderView::section {
    background-color: #313244;
    color: #cba6f7;
    padding: 8px;
    border: none;
    border-right: 1px solid #1e1e2e;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1px;
}
QHeaderView::section:last {
    border-right: none;
}
QHeaderView {
    background-color: #313244;
}
QTableView QTableCornerButton::section {
    background-color: #313244;
    border: none;
}
QTableCornerButton::section {
    background-color: #313244;
    border: none;
}
/* Scrollbar */
QScrollBar:vertical {
    background: #1e1e2e;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #585b70;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #1e1e2e;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #45475a;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background: #585b70;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
